%计算概率密度和累计分布

target_columns = [2, 10, 18, 21, 29, 39];
num_points = 100; % 定义每个列的数据点数

% 创建图形窗口
figure('Position', [100, 100, 1200, 800]);

% 预分配矩阵来存储每个列的PDF和CDF数据
pdf_matrix = zeros(num_points, length(target_columns));
cdf_matrix = zeros(num_points, length(target_columns));
xi_matrix = zeros(num_points, length(target_columns));
cdf_x_matrix = zeros(num_points, length(target_columns));

% 对每个目标列进行计算和绘图
for i = 1:length(target_columns)
    col = target_columns(i);
    
    % 提取当前列的数据
    data = FLSM(:, col);
    
    % 子图位置
    subplot(2, 3, i);
    
    % 计算概率密度函数(PDF) - 使用核密度估计
    [f, xi] = ksdensity(data, 'NumPoints', num_points);
    
    % 计算累积分布函数(CDF) - 使用经验分布函数
    [cdf_values, cdf_x] = ecdf(data);
    
    % 确保CDF数据是有效的
    if length(cdf_x) < 2
        % 如果数据点太少，使用简单的线性CDF
        cdf_x_interp = linspace(min(data), max(data), num_points);
        cdf_values_interp = (cdf_x_interp - min(data)) / (max(data) - min(data));
    else
        % 确保cdf_x是严格递增的，避免插值问题
        [cdf_x_unique, idx] = unique(cdf_x);
        cdf_values_unique = cdf_values(idx);
        
        % 创建插值点
        cdf_x_interp = linspace(min(cdf_x_unique), max(cdf_x_unique), num_points);
        
        % 使用更稳健的插值方法
        if length(cdf_x_unique) > 1
            cdf_values_interp = interp1(cdf_x_unique, cdf_values_unique, cdf_x_interp, 'linear', 'extrap');
        else
            % 如果只有一个点，使用简单线性
            cdf_values_interp = linspace(0, 1, num_points);
        end
    end
    
    % 确保CDF值在[0,1]范围内
    cdf_values_interp = max(0, min(1, cdf_values_interp));
    
    % 保存数据到矩阵
    pdf_matrix(:, i) = f;
    cdf_matrix(:, i) = cdf_values_interp;
    xi_matrix(:, i) = xi;
    cdf_x_matrix(:, i) = cdf_x_interp;
    
    % 绘制PDF和CDF
    yyaxis left;
    plot(xi, f, 'b-', 'LineWidth', 2);
    ylabel('概率密度函数 (PDF)');
    ylim([0, max(f)*1.1]);
    
    yyaxis right;
    plot(cdf_x_interp, cdf_values_interp, 'r-', 'LineWidth', 2);
    ylabel('累积分布函数 (CDF)');
    ylim([0, 1.05]);
    
    title(sprintf('第 %d 列的PDF和CDF', col));
    xlabel('数值');
    grid on;
    legend('PDF', 'CDF', 'Location', 'best');
end


