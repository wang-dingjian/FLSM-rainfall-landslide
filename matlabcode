clear; clc;

fprintf('Stability analysis during rainfall...\n');

X = xlsread('../data/geometry_data.xlsx', 'A2:L41');

m1 = 10000;  
n = 40;   


q = 4/3600/1000; 
t = 100*3600;      

theta_delta_mean = 0.19;
theta_delta_std = 0.0019;
phi_mean =-1.260251661;
phi_std =0.079872442;
c_mean =2.392920107;
c_std = 0.099751345;
s_mean = 4.78744174528188;
s_std = 0.00999975001354021;
psai_mean = -0.223193548814376;
psai_std = 0.00999975001354021;
Ks_mean = -13.94048143;
Ks_std = 0.1980422004 ;

theta_delta = normrnd(theta_delta_mean, theta_delta_std, m1, n);
phi = lognrnd(phi_mean, phi_std, m1, n);
c = lognrnd(c_mean, c_std, m1, n);
s = lognrnd(s_mean, s_std, m1, n);
psai = lognrnd(psai_mean, psai_std, m1, n);
Ks = lognrnd(Ks_mean, Ks_std, m1, n);
Ks = lognrnd(Ks_mean, Ks_std, m1, n);
Ks = lognrnd(Ks_mean, Ks_std, m1, n);
Ks = lognrnd(Ks_mean, Ks_std, m1, n);
Ks = lognrnd(Ks_mean, Ks_std, m1, n);
gama_s = normrnd(gama_s_mean, gama_s_std, m1, n);    
gama_a = normrnd(gama_a_mean, gama_a_std, m1, n);   
phi_b = normrnd(phi_b_mean, phi_b, m1, n); 
gama_w = 10;     


fprintf('Calculate geometric parameters...\n');

H = zeros(1, n);     
h = zeros(1, n);    
l = zeros(1, n);     
alpha = zeros(1, n);  
beta = zeros(1, n);  

for j = 1:n
    H(j) = X(j, 2) - X(j, 8);
    h(j) = X(j, 10) - X(j, 8);
    l(j) = sqrt((X(j, 7) - X(j, 5))^2 + (X(j, 8) - X(j, 6))^2);
    
    dx_alpha = X(j, 5) - X(j, 7);
    if abs(dx_alpha) > 1e-10
        alpha(j) = atan((X(j, 6) - X(j, 8)) / dx_alpha);
    else
        alpha(j) = sign(X(j, 6) - X(j, 8)) * pi/2;
    end
    
    dx_beta = X(j, 3) - X(j, 1);
    if abs(dx_beta) > 1e-10
        beta(j) = atan((X(j, 4) - X(j, 2)) / dx_beta);
    else
        beta(j) = sign(X(j, 4) - X(j, 2)) * pi/2;
    end
end

alpha = [alpha, 0]; 
h = [h, 0];
H = [H, 0];

fprintf('Memory allocation...\n');

z_p = zeros(m1, n);      
t_p = zeros(m1, n);    
z_f = zeros(m1, n);     
eta = zeros(m1, n);     
c_psai = zeros(m1, n);  


fprintf('Start the main computation loop...\n', m1);

for i = 1:m1
    if mod(i, 100) == 0
        fprintf('Sample processing', i, m1);
    end
    
    El = zeros(1, n+1); 
    Eu = zeros(1, n+1);  
    G = zeros(1, n);    
    P = zeros(1, n);    
    Q = zeros(1, n);     
    lama = zeros(1, n);  
    epsi = zeros(1, n); 
    kapa = zeros(1, n); 
    
    for j = 1:n
        denominator = (q / Ks(i,j) - 1);
        if denominator <= 1e-10
            z_p(i,j) = 0.1;
            t_p(i,j) = 1e10;  
        else
            z_p(i,j) = psai(i,j) / denominator / cos(beta(j));
            t_p(i,j) = psai(i,j) * theta_delta(i,j) / (q * denominator * (cos(beta(j)))^2);
        end
        
        if t < t_p(i,j)
            z_f(i,j) = q * cos(beta(j)) * t / theta_delta(i,j);
        else
           
            func = @(z) theta_delta(i,j)/(Ks(i,j)*cos(beta(j))) * ...
                        (z - z_p(i,j) - psai(i,j)/cos(beta(j))*log((z*cos(beta(j))+psai(i,j))/(z_p(i,j)*cos(beta(j))+psai(i,j)))) + ...
                        t_p(i,j) - t;
            
            z_min = z_p(i,j) + 0.01;
            z_max = 50;
           
            tolerance = 1e-6;
            max_iter = 50;
            
            for iter = 1:max_iter
                z_mid = (z_min + z_max) / 2;
                f_mid = func(z_mid);
                
                if abs(f_mid) < tolerance
                    z_f(i,j) = z_mid;
                    break;
                end
                
                if func(z_min) * f_mid < 0
                    z_max = z_mid;
                else
                    z_min = z_mid;
                end
                
                if iter == max_iter
                    z_f(i,j) = (z_min + z_max) / 2;
                end
            end
        end
        
        z_f(i,j) = max(0, min(z_f(i,j), 0.5*(X(j,2)-X(j,10)+X(j,4)-X(j,12))));
        
        if j > 1 && j < n
            eta(i,j) = min((z_f(i,j)/cos(beta(j)) + 0.5*(h(j)+h(j+1))) / (0.5*(H(j)+H(j+1))), 1);
        elseif j == 1
            eta(i,j) = min(1 - (1 - z_f(i,j)/cos(beta(j))/H(j+1))^2 + h(j+1)/H(j+1), 1);
        else
            eta(i,j) = min(1 - (1 - z_f(i,j)/cos(beta(j))/H(j))^2 + h(j)/H(j), 1);
        end
        
        c_psai(i,j) = c(i,j) + s(i,j) * tan(phi_b) * (1 - eta(i,j))^3.4;
        
        saturated_height = 2 * z_f(i,j) / cos(beta(j)) + h(j) + h(j+1);
        G(j) = 0.5 * (gama_s - gama_w) * saturated_height * l(j) * cos(alpha(j)) + ...
               0.5 * gama_a * (H(j) + H(j+1) - saturated_height) * l(j) * cos(alpha(j));
        
        P(j) = 0.5 * gama_w * l(j) * (h(j) + h(j+1)) * sin(alpha(j)) * cos(alpha(j));
        
        Q(j) = gama_w * l(j) * z_f(i,j) * tan(beta(j)) * sin(alpha(j));
        
        lama(j) = cos(alpha(j) - alpha(j+1)) - sin(alpha(j) - alpha(j+1)) * tan(phi(i,j));
        epsi(j) = cos(alpha(j)) * tan(phi(i,j)) - sin(alpha(j));
        kapa(j) = cos(alpha(j) - beta(j)) + sin(alpha(j) - beta(j)) * tan(phi(i,j));
    end
    
    for k = 2:n
        El(k) = 1/lama(k-1) * (El(k-1) + epsi(k-1)*G(k-1) - kapa(k-1)*Q(k-1) - P(k-1) + c_psai(i,k-1)*l(k-1));
        El(k) = max(El(k), 0);  
    end
    
    for k = (n-1):-1:1
        Eu(k+1) = lama(k+1) * Eu(k+2) - epsi(k+1)*G(k+1) + kapa(k+1)*Q(k+1) + P(k+1) - c_psai(i,k+1)*l(k+1);
        Eu(k+1) = max(Eu(k+1), 0);  
    end
    
    for j = 1:n
        driving_force = Eu(j+1) * cos(alpha(j) - alpha(j+1))+ G(j) * sin(alpha(j)) + P(j) + Q(j) * cos(alpha(j) - beta(j))+ Eu(j+1) * sin(alpha(j) - alpha(j+1)) * tan(phi(i,j))  + Q(j) * sin(alpha(j) - beta(j))* tan(phi(i,j)) ;
                       
        resisting_force = (G(j) * cos(alpha(j)) ) * tan(phi(i,j)) + c_psai(i,j) * l(j)  +  El(j) ;
                         
        if resisting_force > 0
            FLSM(i,j) = (resisting_force - driving_force) / resisting_force;
        else
            FLSM(i,j) = -1;  
        end
    end
end

fprintf('Analysis completed, generate result charts...\n');

FLSM_mean = mean(FLSM, 1);
FLSM_std = std(FLSM, 0, 1);
failure_prob = sum(FLSM < 0, 1) / m1;

figure('Position', [100, 100, 1200, 800]);
subplot(2,3,1);
errorbar(1:n, FLSM_mean, FLSM_std, 'o-', 'LineWidth', 1.5, 'MarkerSize', 4);
xlabel('Slice number');
ylabel('FLSM');
title('(a) FLSM distribution');
grid on;
yline(0, 'r--', 'LineWidth', 2, 'Label', 'Stable limit');


target_columns = [2, 10, 18, 21, 29, 39];
num_points = 100; 

figure('Position', [100, 100, 1200, 800]);

pdf_matrix = zeros(num_points, length(target_columns));
cdf_matrix = zeros(num_points, length(target_columns));
xi_matrix = zeros(num_points, length(target_columns));
cdf_x_matrix = zeros(num_points, length(target_columns));

for i = 1:length(target_columns)
    col = target_columns(i);
    
    data = FLSM(:, col);
    
    subplot(2, 3, i);
    
    [f, xi] = ksdensity(data, 'NumPoints', num_points);
    
    [cdf_values, cdf_x] = ecdf(data);
    
    if length(cdf_x) < 2
        cdf_x_interp = linspace(min(data), max(data), num_points);
        cdf_values_interp = (cdf_x_interp - min(data)) / (max(data) - min(data));
    else
        [cdf_x_unique, idx] = unique(cdf_x);
        cdf_values_unique = cdf_values(idx);
        
        cdf_x_interp = linspace(min(cdf_x_unique), max(cdf_x_unique), num_points);
        
        if length(cdf_x_unique) > 1
            cdf_values_interp = interp1(cdf_x_unique, cdf_values_unique, cdf_x_interp, 'linear', 'extrap');
        else
            cdf_values_interp = linspace(0, 1, num_points);
        end
    end
    
    cdf_values_interp = max(0, min(1, cdf_values_interp));
    
    pdf_matrix(:, i) = f;
    cdf_matrix(:, i) = cdf_values_interp;
    xi_matrix(:, i) = xi;
    cdf_x_matrix(:, i) = cdf_x_interp;
    
    yyaxis left;
    plot(xi, f, 'b-', 'LineWidth', 2);
    ylabel('Probability Density Function (PDF)');
    ylim([0, max(f)*1.1]);
    
    yyaxis right;
    plot(cdf_x_interp, cdf_values_interp, 'r-', 'LineWidth', 2);
    ylabel('Cumulative Distribution Function (CDF)');
    ylim([0, 1.05]);
    
    title(sprintf('PDF and CDF of column %d', col));
    xlabel('Value');
    grid on;
    legend('PDF', 'CDF', 'Location', 'best');
end

